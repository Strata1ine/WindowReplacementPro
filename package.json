{
  "name": "windowreplacement-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run build:public-media",
    "build": "astro build",
    "postbuild": "npm run audit:public-supplier-leakage",
    "preview": "astro preview",
    "check": "astro check",
    "ingest": "python scripts/ingest/crawl.py",
    "ingest:cleanup": "python scripts/ingest/cleanup.py",
    "enrich:catalog": "python scripts/enrich-catalog.py",
    "build:taxonomy": "python scripts/build-taxonomy.py",
    "build:public-media": "node scripts/build-public-media.mjs",
    "qa:homepage": "node scripts/homepage-browser-qa.mjs",
    "ingest:audit": "npm run validate:catalog",
    "validate:catalog": "python scripts/ingest/audit.py && python scripts/enrichment-audit.py",
    "test:catalog": "node --experimental-strip-types scripts/tests/catalog-merge.test.ts",
    "test:crawler": "python -m unittest scripts.tests.test_crawler -v",
    "test:taxonomy": "python -m unittest scripts.tests.test_taxonomy -v",
    "test:public-identity": "node --experimental-strip-types scripts/tests/public-identity.test.ts",
    "test:core-content": "node --experimental-strip-types scripts/tests/core-content.test.ts",
    "test": "npm run test:catalog && npm run test:crawler && npm run test:taxonomy && npm run test:public-identity && npm run test:core-content",
    "validate:taxonomy": "python scripts/validate-taxonomy.py",
    "validate:build": "python scripts/verify-build.py",
    "audit:supplier-completeness": "python scripts/ingest/live_inventory.py && python scripts/supplier-completeness.py",
    "audit:public-identities": "node scripts/audit-public-identities.mjs",
    "audit:public-supplier-leakage": "node scripts/audit-public-supplier-leakage.mjs",
    "audit:core-content": "node scripts/core-content-audit.mjs",
    "verify": "npm run check && npm run validate:catalog && npm run validate:taxonomy && npm run test && npm run build && npm run audit:core-content && npm run validate:build",
    "generate:public-catalogue": "node scripts/generate-public-catalogue.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
