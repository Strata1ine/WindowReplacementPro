---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---
<ol class="process-steps">
  {steps.map((step, index) => (
    <li class="process-step">
      <span class="process-step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    </li>
  ))}
</ol>
