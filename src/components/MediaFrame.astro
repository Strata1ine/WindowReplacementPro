---
import type { PublicMedia } from '../data/public-catalog';

interface Props {
  media: PublicMedia;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  fit?: 'cover' | 'contain';
  responsiveContain?: boolean;
  caption?: string;
}

const {
  media,
  alt,
  class: className,
  sizes = '(max-width: 760px) 100vw, 50vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  fit = 'cover',
  responsiveContain = false,
  caption
} = Astro.props;
---
<figure class:list={['media-frame', 'media-frame--' + fit, responsiveContain && 'media-frame--responsive-contain', className]} style={fit === 'contain' && !responsiveContain ? `background-image:url("${media.src}")` : undefined}>
  <img
    src={media.src}
    srcset={fit === 'cover' || responsiveContain ? media.srcset : undefined}
    sizes={sizes}
    width={media.width}
    height={media.height}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
