---
interface Props {
  deploymentTest?: boolean;
}

const { deploymentTest = false } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap footer-main">
    <div class="footer-intro">
      <a class="brand brand--footer" href="/" aria-label="Window Replacement Pro home">
        <span class="brand-main">Window Replacement</span><span class="brand-pro">.pro</span>
      </a>
      <p>Clear product guidance for replacement windows, entry doors, door glass and patio systems across the Greater Toronto Area and Southern Ontario.</p>
    </div>
    <div class="footer-links">
      <div>
        <h2>Products</h2>
        <a href="/windows/">Replacement windows</a>
        <a href="/doors/">Entry doors</a>
        <a href="/doors/decorative-door-glass/">Door glass</a>
        <a href="/patio-doors/">Patio doors</a>
      </div>
      <div>
        <h2>Plan</h2>
        <a href="/#options">Product options</a>
        <a href="/#process">How it works</a>
        <a href="/locations/">Service areas</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-note">
    <p>We confirm the exact product, available options, performance ratings, installation scope and warranty in your written quotation.</p>
  </div>
  <div class="wrap footer-legal">
    <span>&copy; {new Date().getFullYear()} Window Replacement Pro</span>
    {deploymentTest && <span>Deployment test &mdash; August 20, 2026</span>}
    <span>Ontario, Canada</span>
  </div>
</footer>
