---
import ProductCard from './ProductCard.astro';
import SectionHeader from './SectionHeader.astro';
import { getPublicProductsByCategory } from '../data/public-catalog';

interface Props {
  category: string;
}

const { category } = Astro.props;
const products = getPublicProductsByCategory(category);
const groups = Array.from(products.reduce((map, product) => {
  const current = map.get(product.browseGroup) ?? [];
  current.push(product);
  map.set(product.browseGroup, current);
  return map;
}, new Map<string, typeof products>()).entries());

const groupId = (name: string) => 'catalogue-' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const categoryNames: Record<string, string> = {
  windows: 'replacement windows',
  'entry-doors': 'entry doors',
  'door-glass': 'door-glass options',
  'patio-doors': 'patio-door systems'
};
const categoryName = categoryNames[category] ?? 'products';
---
<section id="catalogue" class="section section--mist public-catalogue" aria-labelledby={`catalogue-${category}-title`}>
  <div class="wrap">
    <SectionHeader
      eyebrow="Product options"
      title={`Compare ${categoryName} by the choice that matters first.`}
      body="Compare configurations by operation, material, appearance and practical use. The exact product and options are confirmed in your written quotation."
      headingId={`catalogue-${category}-title`}
    />
    <nav class="catalogue-filter-nav" aria-label={`${categoryName} groups`}>
      <span>Browse by</span>
      {groups.map(([name]) => <a href={`#${groupId(name)}`}>{name}</a>)}
    </nav>
    <div class="public-catalogue__groups">
      {groups.map(([name, items]) => (
        <section id={groupId(name)} class="public-catalogue__group" aria-labelledby={`${groupId(name)}-title`}>
          <header>
            <p class="eyebrow">{items.length} {items.length === 1 ? 'option' : 'options'}</p>
            <h3 id={`${groupId(name)}-title`}>{name}</h3>
          </header>
          <div class="featured-product-grid">
            {items.map(item => (
              <ProductCard
                name={item.displayName}
                reference={item.reference}
                category={item.categoryLabel}
                href={item.href}
                summary={item.summary}
                highlights={item.specifications.slice(0, 2)}
                media={item.media}
                imageAlt={item.imageAlt}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
