---
import MediaFrame from './MediaFrame.astro';
import type { HomepageMedia } from '../data/homepage';

interface Props {
  title: string;
  description: string;
  href: string;
  count: number;
  countLabel: string;
  media: HomepageMedia;
  imageAlt: string;
}

const { title, description, href, count, countLabel, media, imageAlt } = Astro.props;
---
<a class="category-card" href={href}>
  <MediaFrame
    media={media}
    alt={imageAlt}
    class="category-card__media"
    sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 36vw"
  />
  <div class="category-card__content">
    <p class="category-card__count">{count} {countLabel}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="text-link">Explore {title.toLowerCase()} <span aria-hidden="true">&rarr;</span></span>
  </div>
</a>
