---
const currentPath = Astro.url.pathname;
const currentFor = (prefix: string) => currentPath === prefix || (prefix !== '/' && currentPath.startsWith(prefix));
---
<header class="site-header" data-site-header>
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Window Replacement Pro home">
      <span class="brand-main">Window Replacement</span><span class="brand-pro">.pro</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <details class="nav-dropdown" data-nav-dropdown>
        <summary>Products</summary>
        <div class="nav-dropdown__panel">
          <a href="/windows/">Replacement windows</a>
          <a href="/doors/">Entry doors</a>
          <a href="/doors/decorative-door-glass/">Door glass</a>
          <a href="/patio-doors/">Patio doors</a>
        </div>
      </details>
      <a class:list={[currentFor('/windows/') && 'is-current']} aria-current={currentFor('/windows/') ? 'page' : undefined} href="/windows/">Windows</a>
      <a class:list={[currentFor('/doors/') && 'is-current']} aria-current={currentFor('/doors/') ? 'page' : undefined} href="/doors/">Entry doors</a>
      <a class:list={[currentFor('/patio-doors/') && 'is-current']} aria-current={currentFor('/patio-doors/') ? 'page' : undefined} href="/patio-doors/">Patio doors</a>
      <details class="nav-dropdown" data-nav-dropdown>
        <summary class:list={[(currentFor('/window-replacement/') || currentFor('/window-installation/') || currentPath.endsWith('-replacement-cost/')) && 'is-current']}>Plan</summary>
        <div class="nav-dropdown__panel nav-dropdown__panel--wide">
          <a href="/window-replacement/">Window replacement</a>
          <a href="/window-installation/">Window installation</a>
          <a href="/window-replacement-cost/">Window replacement cost</a>
          <a href="/entry-door-replacement-cost/">Entry-door replacement cost</a>
          <a href="/patio-door-replacement-cost/">Patio-door replacement cost</a>
        </div>
      </details>
      <details class="nav-dropdown" data-nav-dropdown>
        <summary class:list={[(currentFor('/guides/') || currentFor('/energy-efficient-windows/')) && 'is-current']}>Guides</summary>
        <div class="nav-dropdown__panel nav-dropdown__panel--wide">
          <a href="/guides/">All buying guides</a>
          <a href="/guides/window-styles/">Window styles</a>
          <a href="/energy-efficient-windows/">Energy-efficient windows</a>
          <a href="/guides/full-frame-vs-retrofit-windows/">Full frame vs retrofit</a>
          <a href="/guides/double-vs-triple-pane-windows/">Double vs triple pane</a>
          <a href="/guides/window-problems/">Common window problems</a>
        </div>
      </details>
      <a class:list={[currentFor('/locations/') && 'is-current']} aria-current={currentFor('/locations/') ? 'page' : undefined} href="/locations/">Service areas</a>
    </nav>
    <a class="button button--header" href="/#quote">Plan your replacement</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" data-mobile-nav hidden>
    <div class="wrap mobile-nav__inner">
      <p class="mobile-nav__label">Products</p>
      <a href="/windows/">Replacement windows</a>
      <a href="/doors/">Entry doors</a>
      <a href="/doors/decorative-door-glass/">Door glass</a>
      <a href="/patio-doors/">Patio doors</a>
      <div class="mobile-nav__divider"></div>
      <p class="mobile-nav__label">Plan</p>
      <a href="/window-replacement/">Window replacement</a>
      <a href="/window-installation/">Window installation</a>
      <a href="/window-replacement-cost/">Window replacement cost</a>
      <a href="/entry-door-replacement-cost/">Entry-door replacement cost</a>
      <a href="/patio-door-replacement-cost/">Patio-door replacement cost</a>
      <div class="mobile-nav__divider"></div>
      <p class="mobile-nav__label">Guides</p>
      <a href="/guides/">All buying guides</a>
      <a href="/guides/window-styles/">Window styles</a>
      <a href="/energy-efficient-windows/">Energy-efficient windows</a>
      <a href="/guides/full-frame-vs-retrofit-windows/">Full frame vs retrofit</a>
      <a href="/guides/window-problems/">Common window problems</a>
      <div class="mobile-nav__divider"></div>
      <a href="/locations/">Service areas</a>
      <a class="button" href="/#quote">Plan your replacement</a>
    </div>
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = header?.querySelector<HTMLElement>('[data-mobile-nav]');
  const dropdowns = header?.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]') ?? [];
  const closeMenu = (returnFocus = false) => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation menu');
    mobileNav.hidden = true;
    document.body.classList.remove('menu-open');
    if (returnFocus) toggle.focus();
  };
  const openMenu = () => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close navigation menu');
    mobileNav.hidden = false;
    document.body.classList.add('menu-open');
    mobileNav.querySelector<HTMLElement>('a')?.focus();
  };
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    dropdowns.forEach(dropdown => dropdown.open = false);
    if (toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true);
  });
  document.addEventListener('click', event => {
    dropdowns.forEach(dropdown => {
      if (!dropdown.contains(event.target as Node)) dropdown.open = false;
    });
  });
  window.matchMedia('(min-width: 1120px)').addEventListener('change', event => {
    if (event.matches) closeMenu();
  });
</script>
