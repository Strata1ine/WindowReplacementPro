---
import MediaFrame from './MediaFrame.astro';
import type { PublicMedia } from '../data/public-catalog';

interface Props {
  name: string;
  reference: string;
  category: string;
  href: string;
  summary: string;
  highlights: { label: string; value: string }[];
  media: PublicMedia;
  imageAlt: string;
  responsiveMedia?: boolean;
}

const { name, reference, category, href, summary, highlights, media, imageAlt, responsiveMedia = false } = Astro.props;
---
<article class="product-card">
  <a href={href} aria-label={'Explore ' + name}>
    <MediaFrame media={media} alt={imageAlt} class="product-card__media" sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 25vw" fit="contain" responsiveContain={responsiveMedia} />
  </a>
  <div class="product-card__content">
    <p class="product-card__meta"><span>{category}</span><span class="product-card__reference">Reference {reference}</span></p>
    <h3><a href={href}>{name}</a></h3>
    <p class="product-card__summary">{summary}</p>
    {highlights.length > 0 && <dl class="product-card__specs">{highlights.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>}
    <a class="text-link" href={href}>Explore option <span aria-hidden="true">&rarr;</span></a>
  </div>
</article>
