---
import MediaFrame from './MediaFrame.astro';
import type { HomepageMedia } from '../data/homepage';

interface Props {
  productId: string;
  name: string;
  manufacturer: string;
  category: string;
  href: string;
  summary: string;
  highlights: { label: string; value: string }[];
  media: HomepageMedia;
  imageAlt: string;
}

const {
  name,
  manufacturer,
  category,
  href,
  summary,
  highlights,
  media,
  imageAlt
} = Astro.props;
---
<article class="product-card">
  <a href={href} aria-label={`View ${name}`}>
    <MediaFrame
      media={media}
      alt={imageAlt}
      class="product-card__media"
      sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 25vw"
      fit="contain"
    />
  </a>
  <div class="product-card__content">
    <p class="product-card__meta">{category} <span aria-hidden="true">/</span> {manufacturer}</p>
    <h3><a href={href}>{name}</a></h3>
    <p class="product-card__summary">{summary}</p>
    {highlights.length > 0 && (
      <dl class="product-card__specs">
        {highlights.map(item => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )}
    <a class="text-link" href={href}>View product <span aria-hidden="true">&rarr;</span></a>
  </div>
</article>
