---
import MediaFrame from './MediaFrame.astro';
import IllustrativeConfiguration from './IllustrativeConfiguration.astro';
import VisualOptionGroup from './VisualOptionGroup.astro';
import type { PublicProductShowroom } from '../data/public-catalog';

interface Props {
  showroom: PublicProductShowroom;
}

const { showroom } = Astro.props;
---
<div class="product-showroom" data-product-showroom>
  {showroom.groups.map((group, groupIndex) => <VisualOptionGroup group={group} sectionIndex={groupIndex} />)}

  {(showroom.verifiedDetails.length > 0 || showroom.technicalMedia.length > 0 || showroom.privacyIndicator) && (
    <section class="section section--cream showroom-evidence" aria-labelledby="showroom-evidence-title">
      <div class="wrap showroom-evidence__layout">
        <div>
          <p class="eyebrow">Verified details</p>
          <h2 id="showroom-evidence-title">Construction and technical context.</h2>
          <dl class="showroom-detail-list">
            {showroom.verifiedDetails.map(detail => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}
          </dl>
          {showroom.privacyIndicator && (
            <div class="showroom-privacy">
              <p>Privacy reference</p>
              <div class="showroom-privacy__meter" role="img" aria-label={showroom.privacyIndicator.label + ' privacy, ' + showroom.privacyIndicator.value + ' out of ' + showroom.privacyIndicator.max}>
                {Array.from({ length: showroom.privacyIndicator.max }).map((_, index) => <span class:list={{ 'is-filled': index < showroom.privacyIndicator!.value }}>{index + 1}</span>)}
              </div>
              <strong>{showroom.privacyIndicator.label} privacy — {showroom.privacyIndicator.value}/{showroom.privacyIndicator.max}</strong>
              <small>{showroom.privacyIndicator.note}</small>
            </div>
          )}
        </div>
        {showroom.technicalMedia.length > 0 && (
          <div class="showroom-technical-grid">
            {showroom.technicalMedia.map(item => (
              <figure class="showroom-technical-item">
                {item.media && <MediaFrame media={item.media} alt={item.media.alt} sizes="(max-width: 820px) 100vw, 42vw" fit="contain" responsiveContain />}
                {item.diagram && <IllustrativeConfiguration diagram={item.diagram} />}
                <figcaption><strong>{item.label}</strong><span>{item.description}</span><small>{item.availabilityNote}</small></figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</div>