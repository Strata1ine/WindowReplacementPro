  "writingStandard": {
    "principles": [
      "Write from supported supplier facts while using original WindowReplacement.pro language.",
      "Do not turn an option into a standard feature or infer compatibility across models.",
      "State limitations, option dependencies, and configuration uncertainty explicitly.",
      "Prefer practical homeowner distinctions over generic marketing claims.",
      "Keep source evidence and customer-facing editorial copy in separate fields."
    ],
    "summary": {
      "purpose": "Explain what the specific product is, how it differs, and the evidence-backed decision context.",
      "wordRange": [60, 130],
      "prohibited": ["unsupported superlatives", "invented performance claims", "copied supplier marketing", "unverified availability"]
    },
    "keyFeatures": {
      "countRange": [3, 7],
      "rule": "Each feature must trace to a normalized fact or an explicit canonical identity field."
    },
    "bestFor": {
      "rule": "Describe a supported use case or comparison context, not a universal recommendation."
    },
    "considerations": {
      "rule": "Name configuration limits, missing evidence, maintenance, installation, or ordering checks that materially affect the choice."
    },
    "reviewGate": "Only human-reviewed original editorial may advance from editorial-draft to editorial-reviewed, publishable, or published."
  }
