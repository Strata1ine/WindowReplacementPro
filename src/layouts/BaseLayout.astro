---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  deploymentTest?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, deploymentTest = false, structuredData = [] } = Astro.props;
const pageSchemas = Array.isArray(structuredData) ? structuredData : [structuredData];
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://windowreplacement.pro/#organization',
  name: 'Window Replacement Pro',
  url: 'https://windowreplacement.pro/'
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#133a32" />
    <Seo title={title} description={description} noindex={noindex} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {pageSchemas.map(schema => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer deploymentTest={deploymentTest} />
  </body>
</html>
