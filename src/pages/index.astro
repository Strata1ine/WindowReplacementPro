---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteCta from '../components/QuoteCta.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  homepageCategoryPaths,
  homepageFeaturedProducts,
  homepageProcessSteps,
  homepageSpecificationTopics,
  homepageTaxonomyGroups,
  homepageWindowStyles
} from '../data/homepage';

const heroWindow = homepageCategoryPaths.find(category => category.rootCategory === 'replacement-windows');
const heroDoor = homepageCategoryPaths.find(category => category.rootCategory === 'entry-doors');
const heroPatio = homepageCategoryPaths.find(category => category.rootCategory === 'patio-doors');
if (!heroWindow || !heroDoor || !heroPatio) throw new TypeError('Homepage hero requires approved product media');
---
<BaseLayout
  title="Window Replacement Pro | Windows & Doors in Ontario"
  description="Compare replacement windows, entry doors, door glass and patio-door options for homes across the GTA and Southern Ontario."
>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="wrap home-hero__grid">
      <div class="home-hero__content">
        <p class="eyebrow">Complete window and door projects</p>
        <h1 id="home-hero-title">Replacement windows and doors, done right from measurement to installation.</h1>
        <p class="home-hero__lead">Compare styles, glass and performance options, then get a written quotation for the complete installed project.</p>
        <div class="actions">
          <a class="button" href="#quote">Plan your replacement</a>
          <a class="button button--secondary" href="#product-paths">Explore product paths</a>
        </div>
      </div>
      <div class="home-hero__visual" aria-label="Window, entry-door and patio-door examples">
        <MediaFrame media={heroWindow.media} alt={heroWindow.imageAlt} class="home-hero__window" sizes="(max-width: 760px) 92vw, (max-width: 1120px) 58vw, 42vw" loading="eager" fetchpriority="high" />
        <MediaFrame media={heroDoor.media} alt={heroDoor.imageAlt} class="home-hero__door" sizes="(max-width: 760px) 34vw, 18vw" loading="eager" fit="contain" />
        <MediaFrame media={heroPatio.media} alt={heroPatio.imageAlt} class="home-hero__patio" sizes="(max-width: 760px) 48vw, 22vw" loading="eager" />
        <p class="home-hero__caption">Window, entry-door and patio-door options.</p>
      </div>
    </div>
  </section>

  <section id="product-paths" class="section section--cream" aria-labelledby="product-paths-title">
    <div class="wrap">
      <SectionHeader eyebrow="Product paths" title="Start with what you are replacing." body="Explore windows, entry doors, door glass and patio systems, then narrow the choices around your opening and project scope." headingId="product-paths-title" />
      <div class="category-grid">{homepageCategoryPaths.map(category => <CategoryCard {...category} />)}</div>
    </div>
  </section>

  <section id="options" class="selection-overview" aria-labelledby="window-styles-title">
    <div class="section window-styles">
      <div class="wrap">
        <div class="section-split-heading">
          <SectionHeader eyebrow="Styles, materials and options" title="Compare the choices that shape the project." body="Operating style, material, glass, hardware and configuration all affect how the finished replacement looks and works." headingId="window-styles-title" />
          <a class="text-link text-link--top" href="/windows/">View all replacement windows <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="window-style-grid">
          {homepageWindowStyles.map((style, index) => (
            <a class="window-style-card" href={style.href}>
              <span class="window-style-card__index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{style.title}</h3>
              <p>{style.description}</p>
              <span>Explore style <span aria-hidden="true">&rarr;</span></span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="section section--forest taxonomy-section" aria-labelledby="taxonomy-title">
      <div class="wrap">
        <SectionHeader eyebrow="Doors, glass and patio systems" title="Narrow the choices around the opening." body="Compare useful design directions and materials, then confirm the exact configuration during measurement and quotation." headingId="taxonomy-title" />
        <div class="taxonomy-grid">
          {homepageTaxonomyGroups.map(group => (
            <article class="taxonomy-panel">
              <header><div><h3>{group.title}</h3><p>{group.description}</p></div><a href={group.href} aria-label={'Explore all ' + group.title.toLowerCase()}>&rarr;</a></header>
              <ul>{group.options.map(item => <li><a href={item.href}><span>{item.title}</span><span aria-hidden="true">&rarr;</span></a></li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section specification-section" aria-labelledby="specification-title">
    <div class="wrap specification-layout">
      <div class="specification-copy">
        <p class="eyebrow">Why specification matters</p>
        <h2 id="specification-title">A complete project is more than the product.</h2>
        <p class="lead">The frame, glass, hardware, opening, installation method and finish belong in one clear scope. That is what makes quotations comparable and helps avoid gaps between selection and installation.</p>
        <a class="button button--secondary" href="#featured-products">See product examples</a>
      </div>
      <ol class="specification-list">{homepageSpecificationTopics.map((topic, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{topic}</strong></li>)}</ol>
    </div>
  </section>

  <section id="featured-products" class="section section--mist" aria-labelledby="featured-products-title">
    <div class="wrap">
      <div class="section-split-heading">
        <SectionHeader eyebrow="Product examples" title="Common product configurations" body="Explore several common configurations and the specifications that distinguish them." headingId="featured-products-title" />
        <a class="text-link text-link--top" href="#quote">Plan your replacement <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="featured-product-grid">{homepageFeaturedProducts.map(product => <ProductCard {...product} />)}</div>
    </div>
  </section>

  <section id="process" class="section process-section" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHeader eyebrow="From selection to completion" title="A clear path through the replacement process." body="Compare the options, confirm the site measure, review a written scope, then complete supply, installation, finishing and handoff." headingId="process-title" />
      <ProcessSteps steps={homepageProcessSteps} />
    </div>
  </section>

  <section class="section service-section" aria-labelledby="service-title">
    <div class="wrap">
      <div class="service-note">
        <p class="eyebrow">Service area</p>
        <h2 id="service-title">Planning replacement projects across the GTA and Southern Ontario.</h2>
        <p>We serve homeowners across the GTA and Southern Ontario. Project availability depends on location, opening conditions and scope.</p>
        <a class="text-link" href="/locations/">Review service coverage <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>
  <div class="quote-section">
    <div class="wrap"><QuoteCta /></div>
  </div>
</BaseLayout>
