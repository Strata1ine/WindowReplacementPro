---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
import { locations } from '../data/locations';
---
<BaseLayout title="Window Replacement Pro | Windows & Doors Ontario" description="Replacement windows, entry doors and patio doors with clear product guidance, installation expertise and service across Ontario.">
  <section class="hero"><div class="wrap"><div class="eyebrow">Ontario Windows & Doors</div><h1>Window replacement, explained properly.</h1><p class="lead">Compare window styles, entry doors, patio systems and installation methods before you buy. Product information, practical guidance and local replacement service without the usual guesswork.</p><div class="actions"><a class="button" href="#quote">Get an Estimate</a><a class="button secondary" href="/windows/">Explore Windows</a></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Products</div><h2>Start with what you're replacing.</h2><p>Product-first navigation keeps manufacturer collections underneath clear homeowner categories.</p></div><div class="grid">{products.slice(0,6).map((p)=><a class="card" href={`/${p.category === 'entry-doors' ? 'doors' : p.category}/${p.slug}/`}><span class="tag">{p.type}</span><h3>{p.name}</h3><p>{p.summary}</p></a>)}</div></div></section>
  <section class="section alt"><div class="wrap split"><div><div class="eyebrow">Why this site is different</div><h2>Useful before you ever request a quote.</h2><p class="lead">The site is being built around real product data, installation methods, pricing factors, manufacturer documentation and local project evidence—not hundreds of city-name swaps.</p></div><div class="metric-grid"><div class="metric"><strong>10</strong><span>supplier libraries</span></div><div class="metric"><strong>{products.length}</strong><span>starter product categories</span></div><div class="metric"><strong>{locations.length}</strong><span>launch locations</span></div><div class="metric"><strong>100%</strong><span>static-first pages</span></div></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Service Areas</div><h2>Built for local search without thin local pages.</h2></div><div class="grid">{locations.slice(0,9).map((l)=><a class="card" href={`/locations/${l.slug}/`}><span class="tag">{l.region}</span><h3>{l.name}</h3><p>{l.intro}</p></a>)}</div></div></section>
  <section id="quote" class="section alt"><div class="wrap split"><div><div class="eyebrow">Estimate</div><h2>Tell us what you're replacing.</h2><p>Starter form markup is included now. The production endpoint can later route submissions to email, CRM or a Cloudflare Worker.</p></div><form class="quote-box" method="post" action="#"><div class="input-row"><div class="field"><label for="project">Project</label><select id="project" name="project"><option>Windows</option><option>Entry door</option><option>Patio door</option><option>Multiple products</option></select></div><div class="field"><label for="count">Approx. quantity</label><input class="input" id="count" name="count" inputmode="numeric" /></div></div><div class="input-row"><div class="field"><label for="city">City</label><input class="input" id="city" name="city" /></div><div class="field"><label for="postal">Postal code</label><input class="input" id="postal" name="postal" /></div></div><div class="field"><label for="details">Project details</label><textarea id="details" name="details" rows="4"></textarea></div><button class="button" type="button">Estimate Form — Endpoint Pending</button></form></div></section>
</BaseLayout>
