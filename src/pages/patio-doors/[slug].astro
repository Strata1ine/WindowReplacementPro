---
import AuthorityPage from '../../components/AuthorityPage.astro';
import { categoryDetailByPath } from '../../data/category-detail-pages';
import { products } from '../../data/products';
export function getStaticPaths(){return products.filter(product=>product.category==='patio-doors').map(product=>({params:{slug:product.slug},props:{page:categoryDetailByPath['/patio-doors/'+product.slug+'/']}}));}
const { page }=Astro.props;
if (!page) throw new TypeError('Missing patio-door category page');
---
<AuthorityPage page={page} />
