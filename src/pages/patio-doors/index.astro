---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { products } from '../../data/products'; const items=products.filter(p=>p.category==='patio-doors');
---
<BaseLayout title="Patio Doors Ontario | Window Replacement Pro" description="Compare sliding and stacking patio-door replacement systems for Ontario homes."><section class="page-hero"><div class="wrap"><div class="eyebrow">Patio Doors</div><h1>Patio door replacement</h1><p class="lead">Compare mainstream sliding systems, upgraded hardware and large-format stacking configurations.</p></div></section><section class="section alt"><div class="wrap grid">{items.map(p=><a class="card" href={`/patio-doors/${p.slug}/`}><span class="tag">{p.type}</span><h3>{p.name}</h3><p>{p.summary}</p></a>)}</div></section></BaseLayout>
