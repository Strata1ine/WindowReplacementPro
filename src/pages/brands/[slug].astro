---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { manufacturers } from '../../data/manufacturers';
import { products } from '../../data/products';
import { getManufacturerProducts } from '../../data/catalog';
export function getStaticPaths(){return manufacturers.map(manufacturer=>({params:{slug:manufacturer.slug},props:{manufacturer}}));}
const { manufacturer }=Astro.props;
const categories=products.filter(p=>p.manufacturers.includes(manufacturer.slug));
const catalog=getManufacturerProducts(manufacturer.slug, true);
const collections=[...new Set(catalog.map(p=>p.collection).filter(Boolean))];
---
<BaseLayout title={`${manufacturer.name} Products | Window Replacement Pro`} description={`Explore ${manufacturer.name} window and door products available through Window Replacement Pro.`}>
  <div class="wrap breadcrumbs"><a href="/brands/">Manufacturers</a> / {manufacturer.name}</div>
  <section class="page-hero"><div class="wrap prose"><div class="eyebrow">Manufacturer</div><h1>{manufacturer.name}</h1><p class="lead">{manufacturer.summary}</p><p>{catalog.length} catalog records currently indexed{collections.length ? ` across ${collections.length} collections` : ''}.</p></div></section>
  <section class="section alt"><div class="wrap"><h2>Product categories</h2><div class="grid">{categories.map(p=>{const root=p.category==='entry-doors'?'doors':p.category;return <a class="card" href={`/${root}/${p.slug}/`}><span class="tag">{p.type}</span><h3>{p.name}</h3><p>{p.summary}</p></a>})}</div></div></section>
  {catalog.length > 0 && <section class="section"><div class="wrap"><div class="section-head"><div class="eyebrow">Manufacturer catalog</div><h2>Models and designs</h2><p>Structured supplier records used by WindowReplacement.pro. Media and technical documents are attached automatically by the ingestion crawler.</p></div><div class="catalog-grid">{catalog.map(item => <a class="catalog-row" href={`/products/${item.manufacturer}/${item.slug}/`}><span><strong>{item.name}</strong>{item.collection && <small>{item.collection}</small>}</span>{item.modelNumber && <code>{item.modelNumber}</code>}</a>)}</div></div></section>}
</BaseLayout>
