---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { isPublishableLocation, locations } from '../../data/locations'; import { products } from '../../data/products';
export function getStaticPaths(){return locations.filter(isPublishableLocation).map(location=>({params:{slug:location.slug},props:{location}}));}
const { location }=Astro.props;
---
<BaseLayout title={`Window Replacement ${location.name} | Windows & Doors`} description={`Replacement windows, entry doors and patio doors in ${location.name}, Ontario. Product guidance and professional installation.`}><div class="wrap breadcrumbs"><a href="/locations/">Locations</a> / {location.name}</div><section class="page-hero"><div class="wrap prose"><div class="eyebrow">{location.region}</div><h1>Window replacement in {location.name}</h1><p class="lead">{location.intro}</p>{location.neighbourhoods?.length && <p><strong>Areas:</strong> {location.neighbourhoods.join(', ')}</p>}</div></section><section class="section alt"><div class="wrap"><div class="section-head"><h2>Products available in {location.name}</h2><p>This launch page is intentionally a structured foundation. Before indexing at scale, each city page should receive local project photos, housing-stock information, pricing examples and neighbourhood-specific evidence.</p></div><div class="grid">{products.slice(0,6).map(p=>{const root=p.category==='entry-doors'?'doors':p.category;return <a class="card" href={`/${root}/${p.slug}/`}><h3>{p.name}</h3><p>{p.summary}</p></a>})}</div></div></section></BaseLayout>
