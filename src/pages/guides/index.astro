---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';
const publishedGuides = guides.filter(guide => guide.publishable);
---
<BaseLayout title="Window Replacement Guides | Window Replacement Pro" description="Practical guides to window replacement cost, installation, glazing and common window problems." noindex>
  <section class="page-hero"><div class="wrap"><div class="eyebrow">Knowledge Centre</div><h1>Window replacement guides</h1></div></section>
  <section class="section alt"><div class="wrap grid">{publishedGuides.map(guide =>
    <a class="card" href={'/guides/' + guide.slug + '/'}><h3>{guide.title}</h3><p>{guide.description}</p></a>
  )}</div></section>
</BaseLayout>
