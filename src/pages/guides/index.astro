---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { coreGuidePages } from '../../data/core-content';
const groups = [
  { key: 'windows', title: 'Window planning', description: 'Compare installation methods, glazing, operating styles, performance and common symptoms.' },
  { key: 'doors', title: 'Entry-door planning', description: 'Compare material and complete entrance-system considerations.' },
  { key: 'patio', title: 'Patio-door planning', description: 'Compare panel layouts, frame materials and wider system directions.' }
];
---
<BaseLayout title="Window and Door Buying Guides | Window Replacement Pro" description="Substantive guides to window installation methods, glazing, window styles, entry-door materials, patio systems and common replacement problems.">
  <section class="page-hero guide-hub-hero"><div class="wrap"><p class="eyebrow">Knowledge centre</p><h1>Window and door buying guides.</h1><p class="lead">Use these durable planning resources to understand installation methods, product tradeoffs, performance language and common replacement problems before the measured quotation.</p></div></section>
  <section class="section section--mist guide-hub" aria-labelledby="guide-hub-title"><div class="wrap">
    <header class="section-header"><p class="eyebrow">Topic clusters</p><h2 id="guide-hub-title">Start with the decision you need to make.</h2><p class="section-header__body">Every guide links to relevant product examples and the service pages that explain the complete project scope.</p></header>
    <div class="guide-hub__groups">{groups.map(group => <section><h3>{group.title}</h3><p>{group.description}</p><div>{coreGuidePages.filter(page => page.cluster === group.key).map(page => <a href={page.path}><strong>{page.title}</strong><span>{page.metaDescription}</span><b>Read guide <span aria-hidden="true">→</span></b></a>)}</div></section>)}</div>
  </div></section>
  <section class="section"><div class="wrap authority-callout"><p class="eyebrow">Complete project planning</p><h2>Guides support the decision; measurement confirms the scope.</h2><p>Product compatibility, final performance documentation, installation method, finish work and exact supplied system are confirmed after the opening is assessed and a written quotation is prepared.</p><a class="button" href="/#quote">Plan your replacement</a></div></section>
</BaseLayout>
