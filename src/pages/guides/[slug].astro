---
import BaseLayout from '../../layouts/BaseLayout.astro';
const guides={
'window-replacement-cost':{title:'Window Replacement Cost in Ontario',desc:'A practical framework for understanding installed window replacement pricing in Ontario.'},
'full-frame-vs-retrofit':{title:'Full-Frame vs Retrofit Window Replacement',desc:'Understand the difference between full-frame and retrofit replacement before choosing an installation approach.'},
'double-vs-triple-pane':{title:'Double vs Triple Pane Windows',desc:'Compare double and triple glazing for comfort, efficiency, weight and cost.'},
'window-condensation':{title:'Window Condensation Explained',desc:'Understand interior condensation, exterior condensation and failed insulated glass units.'}
};
export function getStaticPaths(){return Object.entries(guides).map(([slug,guide])=>({params:{slug},props:{guide}}));}
const { guide }=Astro.props;
---
<BaseLayout title={`${guide.title} | Window Replacement Pro`} description={guide.desc}><div class="wrap breadcrumbs"><a href="/guides/">Guides</a> / {guide.title}</div><section class="page-hero"><div class="wrap prose"><div class="eyebrow">Guide</div><h1>{guide.title}</h1><p class="lead">{guide.desc}</p></div></section><section class="section alt"><div class="wrap prose"><h2>Editorial placeholder</h2><p>This route and SEO structure are ready. The production article should be written from verified manufacturer data, installation practice and Ontario-specific evidence rather than generic generated copy.</p></div></section></BaseLayout>
