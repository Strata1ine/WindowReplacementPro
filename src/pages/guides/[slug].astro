---
import AuthorityPage from '../../components/AuthorityPage.astro';
import { coreGuidePages } from '../../data/core-content';

export function getStaticPaths() {
  return coreGuidePages.map(page => ({
    params: { slug: page.path.split('/').filter(Boolean).at(-1) },
    props: { page }
  }));
}
const { page } = Astro.props;
---
<AuthorityPage page={page} />
