---
import AuthorityPage from '../../components/AuthorityPage.astro';
import { categoryDetailByPath } from '../../data/category-detail-pages';
import { products } from '../../data/products';
export function getStaticPaths(){return products.filter(product=>product.category==='windows').map(product=>({params:{slug:product.slug},props:{page:categoryDetailByPath['/windows/'+product.slug+'/']}}));}
const { page } = Astro.props;
if (!page) throw new TypeError('Missing replacement-window category page');
---
<AuthorityPage page={page} />
