---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
import { manufacturers } from '../../data/manufacturers';
export function getStaticPaths(){return products.filter(p=>p.category==='windows').map(product=>({params:{slug:product.slug},props:{product}}));}
const { product } = Astro.props;
const brands = manufacturers.filter(m=>product.manufacturers.includes(m.slug));
---
<BaseLayout title={product.seoTitle} description={product.seoDescription}><div class="wrap breadcrumbs"><a href="/windows/">Windows</a> / {product.name}</div><section class="page-hero"><div class="wrap prose"><div class="eyebrow">{product.type}</div><h1>{product.name}</h1><p class="lead">{product.summary}</p></div></section><section class="section alt"><div class="wrap split"><div><h2>What to compare</h2><p>Performance, glass package, frame construction, hardware, colour, egress requirements, installation method and final opening dimensions all matter. This page is ready for manufacturer specifications, real installation photography and project pricing examples.</p></div><div><h2>Available manufacturers</h2>{brands.map(b=><a class="card" href={`/brands/${b.slug}/`}><h3>{b.name}</h3><p>{b.summary}</p></a>)}</div></div></section></BaseLayout>
