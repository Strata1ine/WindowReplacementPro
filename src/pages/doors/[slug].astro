---
import CommercialCategoryPage from '../../components/CommercialCategoryPage.astro';
import AuthorityPage from '../../components/AuthorityPage.astro';
import { commercialCategoryPages } from '../../data/commercial-categories';
import { categoryDetailByPath } from '../../data/category-detail-pages';
import { products } from '../../data/products';
export function getStaticPaths(){return products.filter(product=>product.category==='entry-doors').map(product=>({params:{slug:product.slug},props:{product,page:categoryDetailByPath['/doors/'+product.slug+'/']}}));}
const { product, page }=Astro.props;
const isDoorGlassLanding = product.slug === 'decorative-door-glass';
if (!isDoorGlassLanding && !page) throw new TypeError('Missing entry-door category page');
---
{isDoorGlassLanding ? <CommercialCategoryPage page={commercialCategoryPages['door-glass']} /> : <AuthorityPage page={page} />}
