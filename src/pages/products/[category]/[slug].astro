---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MediaFrame from '../../../components/MediaFrame.astro';
import ProductCard from '../../../components/ProductCard.astro';
import QuoteCta from '../../../components/QuoteCta.astro';
import { getRelatedPublicProducts, publicProducts } from '../../../data/public-catalog';
import { buildPublicProductSchema } from '../../../data/product-schema';

export function getStaticPaths() {
  return publicProducts.map(product => ({ params: { category: product.category, slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const categoryLanding: Record<string, { href: string; label: string; considerationTitle: string; considerations: string[]; related?: { href: string; label: string } }> = {
  windows: {
    href: '/windows/', label: 'Replacement windows', considerationTitle: 'Confirm the opening and installation method',
    considerations: ['Operating style and room use', 'Glass package and exposure', 'Frame condition and replacement method', 'Interior and exterior finishing']
  },
  'entry-doors': {
    href: '/doors/', label: 'Entry doors', considerationTitle: 'Coordinate the complete entrance',
    considerations: ['Slab, frame and swing', 'Glass, privacy and daylight', 'Finish and visible hardware', 'Sill, sealing and surrounding trim'],
    related: { href: '/doors/decorative-door-glass/', label: 'Compare door-glass options' }
  },
  'door-glass': {
    href: '/doors/decorative-door-glass/', label: 'Door glass', considerationTitle: 'Confirm glass in the complete door system',
    considerations: ['Privacy from inside and outside', 'Daylight and glass size', 'Compatible slab and configuration', 'Sidelite or transom coordination'],
    related: { href: '/doors/', label: 'Compare entry-door configurations' }
  },
  'patio-doors': {
    href: '/patio-doors/', label: 'Patio doors', considerationTitle: 'Confirm the panel system and opening',
    considerations: ['Panel layout and clear opening', 'Frame and glazing package', 'Screen, rollers and locking hardware', 'Sill support, sealing and finishing']
  }
};
const landing = categoryLanding[product.category];
if (!landing) throw new TypeError('Missing category landing for ' + product.category);

const specifications = product.specifications.filter(item => item.label.trim() && item.value.trim());
const groupDefinitions = [
  { title: 'Materials and construction', matches: ['material', 'panel design', 'product type', 'surface', 'profile'] },
  { title: 'Operation and configurations', matches: ['operation', 'configuration', 'layout', 'panel count', 'glass amount'] },
  { title: 'Glazing and privacy', matches: ['glazing', 'glass', 'privacy'] },
  { title: 'Dimensions', matches: ['height', 'width', 'depth', 'dimension', 'size'] },
  { title: 'Performance', matches: ['performance', 'energy', 'u-factor', 'solar', 'air', 'water'] },
  { title: 'Finishes and hardware', matches: ['colour', 'color', 'finish', 'hardware', 'lock', 'screen'] }
];
const assigned = new Set<number>();
const specificationGroups = groupDefinitions.map(group => {
  const items = specifications.filter((item, index) => {
    if (assigned.has(index)) return false;
    const label = item.label.toLowerCase();
    const matched = group.matches.some(term => label.includes(term));
    if (matched) assigned.add(index);
    return matched;
  });
  return { title: group.title, items };
}).filter(group => group.items.length > 0);
const remainingSpecifications = specifications.filter((_item, index) => !assigned.has(index));
if (remainingSpecifications.length) specificationGroups.push({ title: 'Additional details', items: remainingSpecifications });
const relatedProducts = getRelatedPublicProducts(product, 3);

const site = Astro.site;
if (!site) throw new TypeError('Astro site URL is required for public product schema');
const productSchema = buildPublicProductSchema(product, site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: landing.label, item: new URL(landing.href, site).href },
    { '@type': 'ListItem', position: 3, name: product.displayName, item: new URL(product.href, site).href }
  ]
};
---
<BaseLayout title={`${product.displayName} | Window Replacement Pro`} description={product.metaDescription} structuredData={[productSchema, breadcrumbSchema]}>
  <div class="wrap breadcrumbs product-breadcrumbs"><a href={landing.href}>{landing.label}</a><span aria-hidden="true">/</span><span>{product.displayName}</span></div>

  <section class="section public-product public-product--refined">
    <div class="wrap public-product__layout">
      <div class="public-product__media"><MediaFrame media={product.media} alt={product.imageAlt} sizes="(max-width: 820px) 100vw, 48vw" loading="eager" fetchpriority="high" fit="contain" /></div>
      <div class="public-product__content">
        <p class="product-card__meta"><span>{product.categoryLabel}</span><span class="product-card__reference">Reference {product.reference}</span></p>
        <h1>{product.displayName}</h1>
        <p class="lead" data-product-editorial="summary">{product.summary}</p>
        <div class="actions">
          <a class="button" href="#quote">Plan your replacement</a>
          <a class="button button--secondary" href={landing.href}>Compare {landing.label.toLowerCase()}</a>
        </div>
        <div class="product-key-features" aria-labelledby="product-key-features-title">
          <h2 id="product-key-features-title">Key features</h2>
          <ul>{product.keyFeatures.map(item => <li data-product-editorial="fact"><strong>{item}</strong></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  {product.gallery.length > 0 && (
    <section class="section product-gallery-section" aria-labelledby="product-gallery-title">
      <div class="wrap">
        <header class="section-header" data-product-shared-ui><p class="eyebrow">Product media</p><h2 id="product-gallery-title">Configuration and detail views.</h2><p class="section-header__body">Use these views to compare proportions and visible details. Final colours and components are confirmed for the measured configuration.</p></header>
        <div class="product-gallery-grid">
          {product.gallery.map(media => <figure><MediaFrame media={media} alt={media.alt} sizes="(max-width: 760px) 100vw, 50vw" fit="contain" /><figcaption data-product-editorial="fact">{media.alt}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--mist product-editorial-section" aria-labelledby="product-selection-guidance-title">
    <div class="wrap">
      <header class="section-header"><p class="eyebrow">Selection guidance</p><h2 id="product-selection-guidance-title">Where this configuration fits.</h2><p class="section-header__body" data-product-editorial="guidance">{product.selectionGuidance}</p></header>
      <div class="product-editorial-grid">
        <section><h3>Best for</h3><ul>{product.bestFor.map(item => <li data-product-editorial="guidance">{item}</li>)}</ul></section>
        <section><h3>Configuration options</h3><ul>{product.configurationOptions.map(item => <li data-product-editorial="fact">{item}</li>)}</ul></section>
        <section><h3>Considerations</h3><ul>{product.considerations.map(item => <li data-product-editorial="guidance">{item}</li>)}</ul></section>
      </div>
    </div>
  </section>

  {specificationGroups.length > 0 && (
    <section class="section section--cream product-specification-section" aria-labelledby="product-specifications-title">
      <div class="wrap">
        <header class="section-header" data-product-shared-ui><p class="eyebrow">Product details</p><h2 id="product-specifications-title">Specifications available for comparison.</h2><p class="section-header__body">These documented characteristics provide a starting point; the measured configuration determines the final specification.</p></header>
        <div class="product-specification-groups">
          {specificationGroups.map(group => (
            <section><h3>{group.title}</h3><dl>{group.items.map(item => <div><dt>{item.label}</dt><dd data-product-editorial="fact">{item.value}</dd></div>)}</dl></section>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--forest product-considerations" aria-labelledby="product-considerations-title">
    <div class="wrap product-considerations__layout">
      <div><p class="eyebrow">Complete project scope</p><h2 id="product-considerations-title">{landing.considerationTitle}</h2><p class="lead" data-product-editorial="guidance">{product.projectGuidance}</p></div>
      <ol data-product-shared-ui>{landing.considerations.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>)}</ol>
    </div>
  </section>

  {(relatedProducts.length > 0 || landing.related) && (
    <section class="section section--mist product-related" aria-labelledby="product-related-title">
      <div class="wrap">
        <header class="section-header"><p class="eyebrow">Continue comparing</p><h2 id="product-related-title">Related products and useful alternatives.</h2><p class="section-header__body" data-product-editorial="guidance">{product.comparisonGuidance}</p></header>
        {relatedProducts.length > 0 && <div class="featured-product-grid" data-product-shared-ui>{relatedProducts.map(item => <ProductCard name={item.displayName} reference={item.reference} category={item.categoryLabel} href={item.href} summary={item.summary} highlights={item.specifications.slice(0, 3)} media={item.media} imageAlt={item.imageAlt} />)}</div>}
        {landing.related && <a class="related-option-link" data-product-shared-ui href={landing.related.href}><strong>{landing.related.label}</strong><span>Review the connected category choices before the complete entrance is specified.</span><b>Continue <span aria-hidden="true">&rarr;</span></b></a>}
      </div>
    </section>
  )}

  <aside class="wrap source-note product-disclosure" data-product-shared-ui>{product.quoteNote}</aside>
  <div class="quote-section product-quote" data-product-shared-ui><div class="wrap"><QuoteCta /></div></div>
</BaseLayout>