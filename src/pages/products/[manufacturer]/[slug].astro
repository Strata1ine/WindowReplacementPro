---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { catalogProducts } from '../../../data/catalog';
import { manufacturers } from '../../../data/manufacturers';

export function getStaticPaths() {
  return catalogProducts.map(product => ({
    params: { manufacturer: product.manufacturer, slug: product.slug },
    props: { product }
  }));
}
const { product } = Astro.props;
const manufacturer = manufacturers.find(m => m.slug === product.manufacturer);
const title = `${product.name}${manufacturer ? ` by ${manufacturer.name}` : ''} | Window Replacement Pro`;
const description = product.summary || `Explore ${product.name}, available specifications and replacement options from Window Replacement Pro.`;
---
<BaseLayout title={title} description={description}>
  <main class="section">
    <div class="container narrow">
      <p class="eyebrow"><a href={`/brands/${product.manufacturer}/`}>{manufacturer?.name ?? product.manufacturer}</a>{product.collection ? ` / ${product.collection}` : ''}</p>
      <h1>{product.name}</h1>
      {product.modelNumber && <p class="lede">Model <strong>{product.modelNumber}</strong></p>}
      {product.summary && <p class="lede">{product.summary}</p>}

      {product.media?.filter((x:string) => !x.endsWith('.pdf')).length > 0 && <section class="product-gallery">
        {product.media.filter((x:string) => !x.endsWith('.pdf')).slice(0,12).map((src:string) => <img src={src} alt={`${product.name} by ${manufacturer?.name ?? product.manufacturer}`} loading="lazy" />)}
      </section>}

      {Object.keys(product.specifications || {}).length > 0 && <section class="card detail-card">
        <h2>Product details</h2>
        <dl class="spec-list">
          {Object.entries(product.specifications).map(([key, value]) => <>
            <dt>{key.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase())}</dt>
            <dd>{Array.isArray(value) ? value.join(', ') : value}</dd>
          </>)}
        </dl>
      </section>}

      {product.documents?.length > 0 && <section>
        <h2>Technical documents</h2>
        <ul>{product.documents.map((href:string) => <li><a href={href}>View manufacturer document</a></li>)}</ul>
      </section>}

      <aside class="source-note">Manufacturer information last verified {product.lastVerified}. Product availability and specifications should be confirmed when ordering.</aside>
    </div>
  </main>
</BaseLayout>
